# ==============================================================================
# Midori VPN — Extensión Web (.env.example)
# ==============================================================================

APP_ENV=development

# URL base de vpn-core
API_URL=https://vpn.example.com
ACCOUNT_URL=https://vpn.example.com
PUBLIC_BASE_URL=https://vpn.example.com

# Autenticación OIDC (Astian Accounts)
AUTHENTIK_ISSUER=https://accounts.example.com/application/o/vpn/
AUTHENTIK_AUTHORIZATION_URL=https://accounts.example.com/application/o/authorize/
AUTHENTIK_CLIENT_ID=your_public_client_id_here
AUTHENTIK_REDIRECT_URI=https://vpn.example.com/extension/callback
