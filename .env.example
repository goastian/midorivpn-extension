# Runtime
BROWSER=firefox
APP_ENV=development
APP_NAME=MidoriVPN
HOST=localhost
PORT=3000

# Permissions / UX
# When true, the built manifest declares all-site access as a required host permission.
# Set to false only for builds that should request this host permission at runtime.
REQUIRE_ALL_URLS_PERMISSION=true

# Seconds to show the granted countdown before closing welcome.html.
PERMISSIONS_CLOSE_DELAY_SECONDS=3

# Backend
# Use deployment-specific values here. Do not commit production URLs into this file.
API_URL=https://vpn.example.com
ACCOUNT_URL=https://vpn.example.com

# OAuth / Authentik
# These are examples only. Replace them with your own deployment values.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=

# Optional explicit authorization endpoint. Leave empty to derive it from AUTHENTIK_ISSUER.
AUTHENTIK_AUTHORIZATION_URL=

# OAuth callback URL — choose one strategy only.
# Option A: explicit full URI (takes precedence if set)
AUTHENTIK_REDIRECT_URI=

# Option B: derived from PUBLIC_BASE_URL + EXTENSION_CALLBACK_PATH
PUBLIC_BASE_URL=https://vpn.example.com
EXTENSION_CALLBACK_PATH=/extension/callback

# Diagnostics
# Set to true only for local debug builds. Never ship production builds with this enabled.
DEBUG_DIAG=false
