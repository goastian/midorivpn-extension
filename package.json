    "build:firefox": "BROWSER=firefox node compress-pngs.js && BROWSER=firefox node ./config/webpack.prod.js",
    "build:chrome": "BROWSER=chrome node compress-pngs.js && BROWSER=chrome node ./config/webpack.prod.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint -- --max-warnings=0 && npm test && npm run build:firefox && npm run build:chrome"
