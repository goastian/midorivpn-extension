{
  "name": "midorivpn-extension",
  "version": "2.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node compress-pngs.js && node ./config/webpack.dev.js",
    "build": "node compress-pngs.js && node ./config/webpack.prod.js",
    "build:firefox": "BROWSER=firefox node compress-pngs.js && BROWSER=firefox node ./config/webpack.prod.js",
    "build:chrome": "BROWSER=chrome node compress-pngs.js && BROWSER=chrome node ./config/webpack.prod.js",
    "release:build": "bash scripts/build-release-artifacts.sh",
    "release:validate": "bash scripts/validate-store-release.sh",
    "lint:firefox-package": "bash scripts/lint-firefox-package.sh",
    "audit:security": "node scripts/audit-security.mjs",
    "test:audit-policy": "node --test scripts/audit-policy.test.mjs",
    "test:web-ext-hardening": "node scripts/test-web-ext-image-hardening.cjs",
    "check:no-popup": "node scripts/check-no-programmatic-popup.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint -- --max-warnings=0 && npm run check:no-popup && npm run test:coverage && npm run build:firefox && rm -rf dist-firefox && cp -a dist dist-firefox && npm run lint:firefox-package && npm run build:chrome"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goastian/midorivpn-extension.git"
  },
  "keywords": [],
  "author": "Astian Inc",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/goastian/midorivpn-extension/issues"
  },
  "homepage": "https://github.com/goastian/midorivpn-extension#readme",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "^2.5.1",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^31.0.1",
    "mini-css-extract-plugin": "^2.10.2",
    "sharp": "^0.35.4",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-loader": "^17.4.2",
    "web-ext": "10.8.0",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1",
    "zip-webpack-plugin": "^4.0.3"
  },
  "overrides": {
    "colord": "2.12.0",
    "glob": "14.0.6",
    "js-beautify": "2.0.3",
    "minimatch": "11.0.8",
    "multimatch": {
      "minimatch": "3.1.5"
    },
    "svgo": "3.3.5",
    "uuid": "^11.1.1"
  }
}
